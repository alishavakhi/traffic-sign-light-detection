# Copy to .env and fill in, then:  set -a; source .env; set +a
#
# Roboflow API key, used by:
#   src/train.py    --route roboflow   (download the dataset)
#   src/predict.py  --backend roboflow (query the hosted model)
#
# Get it from https://app.roboflow.com/ -> Settings -> API Keys.
# Never commit the real key: .env is in .gitignore.
ROBOFLOW_API_KEY=
